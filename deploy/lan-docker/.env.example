# Copy to /data/alpha/.env, replace every CHANGE_ME value, and set mode 0600.
ALPHA_POSTGRES_USER=alpha
ALPHA_POSTGRES_PASSWORD=CHANGE_ME
ALPHA_POSTGRES_DB=alpha

ALPHA_REDIS_PASSWORD=CHANGE_ME

ALPHA_CLICKHOUSE_DB=alpha_analytics
ALPHA_CLICKHOUSE_USER=alpha
ALPHA_CLICKHOUSE_PASSWORD=CHANGE_ME

ALPHA_GEOIP_ENABLED=true
ALPHA_USER_PUBLIC_ORIGIN=http://192.168.31.192:3000
ALPHA_AUTH_COOKIE_MAX_AGE=3600
ALPHA_AUTH_COOKIE_SECURE=false
ALPHA_SUBSCRIPTION_PROXY_PATH=/api/subscribe
