services:
  clickhouse:
    image: "{{ clickhouse_image }}"
    container_name: alpha-clickhouse
    restart: unless-stopped
    environment:
      CLICKHOUSE_DB: {{ clickhouse_database | to_json }}
      CLICKHOUSE_USER: {{ clickhouse_username | to_json }}
      CLICKHOUSE_PASSWORD: {{ clickhouse_password | to_json }}
      CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT: "1"
      TZ: {{ timezone | to_json }}
    ports:
      - "{{ clickhouse_bind_host }}:{{ clickhouse_native_port }}:9000"
      - "{{ clickhouse_bind_host }}:{{ clickhouse_http_port }}:8123"
    volumes:
      - {{ deploy_root }}/clickhouse/data:/var/lib/clickhouse
      - {{ deploy_root }}/clickhouse/log:/var/log/clickhouse-server
    ulimits:
      nofile:
        soft: 262144
        hard: 262144
    healthcheck:
      test: ["CMD-SHELL", "clickhouse-client --user \"$${CLICKHOUSE_USER}\" --password \"$${CLICKHOUSE_PASSWORD}\" --query 'SELECT 1'"]
      interval: 10s
      timeout: 5s
      retries: 18
    stop_grace_period: 60s
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
