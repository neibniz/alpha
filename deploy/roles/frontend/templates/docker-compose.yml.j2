services:
  admin:
    image: "{{ frontend_effective_image }}"
    container_name: alpha-admin-web
    restart: unless-stopped
    network_mode: host
    read_only: true
    environment:
      ALPHA_ADMIN_BIND: 127.0.0.1
      ALPHA_ADMIN_PORT: "{{ frontend_port }}"
      ALPHA_ADMIN_UPSTREAM: {{ frontend_container_upstream_url | to_json }}
    volumes:
      - {{ frontend_runtime_root }}/runtime-config.js:/usr/share/nginx/html/runtime-config.js:ro
    tmpfs:
      - /etc/nginx/conf.d:size=1m,mode=0755
      - /var/cache/nginx:size=32m,mode=0755
      - /var/run:size=1m,mode=0755
      - /tmp:size=16m,mode=1777
    mem_limit: 256m
    cpus: 0.5
    pids_limit: 100
    stop_grace_period: 10s
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETGID
      - SETUID
      - NET_BIND_SERVICE
    security_opt:
      - no-new-privileges:true
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:{{ frontend_port }}/healthz"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 10s
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
