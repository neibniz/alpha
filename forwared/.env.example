ALPHA_FORWARED_BASE_URL=https://api.example.com
ALPHA_FORWARED_SECRET_KEY=replace-with-a-dedicated-secret-at-least-32-bytes
ALPHA_FORWARED_NAME=edge-forwarder
ALPHA_FORWARED_PUBLIC_IP=
# Official IP2Location download token, not the Server bootstrap secret.
ALPHA_FORWARED_IP2LOCATION_TOKEN=
ALPHA_FORWARED_IP2LOCATION_CODE=DB3LITEBINIPV6
# Alternative: a trusted HTTPS ZIP/BIN source. It takes precedence over the token.
ALPHA_FORWARED_GEOIP_URL=
ALPHA_FORWARED_GEOIP_UPDATE_INTERVAL=86400
