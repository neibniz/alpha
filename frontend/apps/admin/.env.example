# API base URL
VITE_API_BASE_URL=
# API prefix path
VITE_API_PREFIX=
# Admin authorization cookie name
VITE_AUTH_COOKIE_NAME=alpha_admin_authorization

# Optional development proxy overrides
API_PROXY_TARGET=
# Use "omit" only when a trusted remote development backend rejects local origins.
API_PROXY_ORIGIN=

# CDN URL for static assets
VITE_CDN_URL=https://cdn.jsdmirror.com

# Enable tutorial document feature (true/false)
VITE_TUTORIAL_DOCUMENT=true

# Default login credentials (for development only)
VITE_USER_EMAIL=
VITE_USER_PASSWORD=
