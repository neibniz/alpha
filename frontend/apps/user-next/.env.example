# Root URL of the Alpha HTTP service. The Next.js BFF appends /api by default.
ALPHA_UPSTREAM_URL=http://server:8080
ALPHA_UPSTREAM_API_PREFIX=
ALPHA_SUBSCRIPTION_PROXY_PATH=/v1/subscribe/config
ALPHA_AUTH_COOKIE_NAME=alpha_user_authorization
ALPHA_AUTH_COOKIE_MAX_AGE=3600
ALPHA_AUTH_COOKIE_SECURE=true
ALPHA_PUBLIC_ORIGIN=https://panel.example.com

# Enable only when the app is directly behind a trusted reverse proxy and
# ALPHA_PUBLIC_ORIGIN cannot be set.
ALPHA_TRUST_PROXY_HEADERS=false

# Address header exposed by the deployment edge: cloudflare, vercel, forwarded,
# auto, or none. Use an explicit production value when possible.
ALPHA_CLIENT_IP_SOURCE=auto

# Optional comma-separated hostnames allowed to access the local Next.js dev server.
ALPHA_ALLOWED_DEV_ORIGINS=

# Explicitly enable seeded UI data for local visual development.
NEXT_PUBLIC_ALPHA_DEMO=false
