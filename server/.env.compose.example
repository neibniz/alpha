# Copy to .env. Prefer an immutable release tag or digest in production.
ALPHA_SERVER_IMAGE=ghcr.io/neibniz/alpha-server:latest

# All data services bind only to host loopback. If a port is occupied, change
# the host-side value here and the matching address in etc/alpha.compose.yaml.
ALPHA_POSTGRES_BIND=127.0.0.1:5432
ALPHA_REDIS_BIND=127.0.0.1:6379
ALPHA_CLICKHOUSE_NATIVE_BIND=127.0.0.1:9000
ALPHA_CLICKHOUSE_HTTP_BIND=127.0.0.1:8123

ALPHA_GEOIP_ENABLED=true
ALPHA_SERVER_MEMORY_LIMIT=2g
ALPHA_SERVER_CPUS=2.0
