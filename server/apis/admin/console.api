syntax = "v1"

info (
	title:   "Console API"
	desc:    "API for alpha"
	author:  "Tension"
	email:   "tension@alpha.com"
	version: "0.0.1"
)

type (
	StatisticsPeriodRequest {
		Period string `form:"period,optional"`
	}
	UserStatistics {
		Date              string           `json:"date,omitempty"`
		Register          int64            `json:"register"`
		NewOrderUsers     int64            `json:"new_order_users"`
		RenewalOrderUsers int64            `json:"renewal_order_users"`
		MembershipUsers   int64            `json:"membership_users"`
	}
	OrdersStatistics {
		Date               string             `json:"date,omitempty"`
		AmountTotal        int64              `json:"amount_total"`
		NewOrderAmount     int64              `json:"new_order_amount"`
		RenewalOrderAmount int64              `json:"renewal_order_amount"`
		MembershipAmount   int64              `json:"membership_amount"`
		ResetTrafficAmount int64              `json:"reset_traffic_amount"`
	}
	RevenueStatisticsResponse {
		Period      string             `json:"period"`
		Granularity string             `json:"granularity"`
		Series      []OrdersStatistics `json:"series"`
		Today       OrdersStatistics   `json:"today"`
		Monthly     OrdersStatistics   `json:"monthly"`
		All         OrdersStatistics   `json:"all"`
	}
	UserStatisticsResponse {
		Period      string           `json:"period"`
		Granularity string           `json:"granularity"`
		Series      []UserStatistics `json:"series"`
		Today       UserStatistics   `json:"today"`
		Monthly     UserStatistics   `json:"monthly"`
		All         UserStatistics   `json:"all"`
	}
)

@server (
	prefix:     v1/admin/console
	group:      admin/console
	middleware: AuthMiddleware
)
service alpha {
	@doc "Query revenue statistics"
	@handler QueryRevenueStatistics
	get /revenue (StatisticsPeriodRequest) returns (RevenueStatisticsResponse)

	@doc "Query user statistics"
	@handler QueryUserStatistics
	get /user (StatisticsPeriodRequest) returns (UserStatisticsResponse)
}
