syntax = "v1"

info (
	title:   "Node API"
	desc:    "API for alpha"
	author:  "Tension"
	email:   "tension@alpha.com"
	version: "0.0.1"
)

import "../types.api"

type (
	ServerStatus {
		Cpu                       float64 `json:"cpu"`
		Mem                       float64 `json:"mem"`
		Disk                      float64 `json:"disk"`
		Status                    string  `json:"status"`
		NetRxBps                  int64   `json:"net_rx_bps,omitempty"`
		NetTxBps                  int64   `json:"net_tx_bps,omitempty"`
		NetRxBytes                int64   `json:"net_rx_bytes,omitempty"`
		NetTxBytes                int64   `json:"net_tx_bytes,omitempty"`
		XrayRxBps                 int64   `json:"xray_rx_bps,omitempty"`
		XrayTxBps                 int64   `json:"xray_tx_bps,omitempty"`
		XrayRxBytes               int64   `json:"xray_rx_bytes,omitempty"`
		XrayTxBytes               int64   `json:"xray_tx_bytes,omitempty"`
		XrayStatsError            string  `json:"xray_stats_error"`
		Connections               int64   `json:"connections,omitempty"`
		SystemConnections         int64   `json:"system_connections,omitempty"`
		SystemInboundConnections  int64   `json:"system_inbound_connections,omitempty"`
		SystemOutboundConnections int64   `json:"system_outbound_connections,omitempty"`
		XrayConnections           int64   `json:"xray_connections,omitempty"`
		XrayInboundConnections    int64   `json:"xray_inbound_connections,omitempty"`
		XrayOutboundConnections   int64   `json:"xray_outbound_connections,omitempty"`
		OnlineUsers               int64   `json:"online_users,omitempty"`
		XrayRunning               bool    `json:"xray_running,omitempty"`
		XrayVersion               string  `json:"xray_version,omitempty"`
		UpdatedAt                 int64   `json:"updated_at,omitempty"`
		LastSeen                  int64   `json:"last_seen,omitempty"`
		Load1                     float64 `json:"load1,omitempty"`
		Load5                     float64 `json:"load5,omitempty"`
		Load15                    float64 `json:"load15,omitempty"`
		Uptime                    int64   `json:"uptime,omitempty"`
		AgentVersion              string  `json:"agent_version,omitempty"`
		ConfigVersion             string  `json:"config_version,omitempty"`
		ConfigSyncStatus          string  `json:"config_sync_status,omitempty"`
		ConfigApplyStatus         string  `json:"config_apply_status,omitempty"`
		LastConfigHash            string  `json:"last_config_hash,omitempty"`
		RunningConfigHash         string  `json:"running_config_hash,omitempty"`
		PendingConfigHash         string  `json:"pending_config_hash"`
		LastSyncAt                int64   `json:"last_sync_at,omitempty"`
		LastApplyAt               int64   `json:"last_apply_at,omitempty"`
		LastConfigError           string  `json:"last_config_error"`
		LastApplyError            string  `json:"last_apply_error"`
	}
	Server {
		Id             int64        `json:"id"`
		Name           string       `json:"name"`
		Country        string       `json:"country"`
		City           string       `json:"city"`
		Address        string       `json:"address"`
		Sort           int          `json:"sort"`
		LastReportedAt int64        `json:"last_reported_at"`
		Status         ServerStatus `json:"status"`
		CreatedAt      int64        `json:"created_at"`
		UpdatedAt      int64        `json:"updated_at"`
	}
	ServerListItem {
		Id             int64        `json:"id"`
		Name           string       `json:"name"`
		Country        string       `json:"country"`
		City           string       `json:"city"`
		Address        string       `json:"address"`
		Sort           int          `json:"sort"`
		LastReportedAt int64        `json:"last_reported_at"`
		Status         ServerStatus `json:"status"`
		NodeCount      int64        `json:"node_count"`
		TemplateCount  int64        `json:"template_count"`
		CreatedAt      int64        `json:"created_at"`
		UpdatedAt      int64        `json:"updated_at"`
	}
	CreateServerRequest {
		Name    string `json:"name"`
		Country string `json:"country,omitempty"`
		City    string `json:"city,omitempty"`
		Address string `json:"address"`
		Sort    int    `json:"sort,omitempty"`
	}
	UpdateServerRequest {
		Id      int64  `json:"id"`
		Name    string `json:"name"`
		Country string `json:"country,omitempty"`
		City    string `json:"city,omitempty"`
		Address string `json:"address"`
		Sort    int    `json:"sort,omitempty"`
	}
	DeleteServerRequest {
		Id int64 `json:"id"`
	}
	FilterServerListRequest {
		Page   int    `form:"page"`
		Size   int    `form:"size"`
		Search string `form:"search,omitempty"`
	}
	FilterServerListResponse {
		Total int64            `json:"total"`
		List  []ServerListItem `json:"list"`
	}
	QueryServerNetworkRateHistoryRequest {
		ServerIds string `form:"server_ids" validate:"required"`
		StartTime int64  `form:"start_time,omitempty"`
		EndTime   int64  `form:"end_time,omitempty"`
		Interval  string `form:"interval,omitempty"`
	}
	ServerNetworkRatePoint {
		Timestamp int64 `json:"timestamp"`
		NetRxBps  int64 `json:"net_rx_bps"`
		NetTxBps  int64 `json:"net_tx_bps"`
		XrayRxBps int64 `json:"xray_rx_bps"`
		XrayTxBps int64 `json:"xray_tx_bps"`
	}
	ServerNetworkRateSeries {
		ServerId int64                    `json:"server_id"`
		Points   []ServerNetworkRatePoint `json:"points"`
	}
	QueryServerNetworkRateHistoryResponse {
		StartTime  int64                     `json:"start_time"`
		EndTime    int64                     `json:"end_time"`
		IntervalMs int64                     `json:"interval_ms"`
		Series     []ServerNetworkRateSeries `json:"series"`
	}
	QueryServerNodeTokenRequest {
		Id int64 `form:"id" validate:"required"`
	}
	QueryServerNodeTokenResponse {
		Token string `json:"token"`
	}
	Node {
		Id           int64    `json:"id"`
		Name         string   `json:"name"`
		Tags         []string `json:"tags"`
		Port         uint16   `json:"port"`
		Address      string   `json:"address"`
		ServerId     int64    `json:"server_id"`
		InboundAlias string   `json:"inbound_alias"`
		Protocol     string   `json:"protocol,omitempty"`
		Enabled      bool     `json:"enabled"`
		Sort         int      `json:"sort,omitempty"`
		CreatedAt    int64    `json:"created_at"`
		UpdatedAt    int64    `json:"updated_at"`
	}
	NodeListItem {
		Id           int64    `json:"id"`
		Name         string   `json:"name"`
		Tags         []string `json:"tags"`
		Port         uint16   `json:"port"`
		Address      string   `json:"address"`
		ServerId     int64    `json:"server_id"`
		InboundAlias string   `json:"inbound_alias"`
		Protocol     string   `json:"protocol,omitempty"`
		Enabled      bool     `json:"enabled"`
		Sort         int      `json:"sort,omitempty"`
		CreatedAt    int64    `json:"created_at"`
		UpdatedAt    int64    `json:"updated_at"`
	}
	CreateNodeRequest {
		Name         string   `json:"name"`
		Tags         []string `json:"tags,omitempty"`
		Port         uint16   `json:"port" validate:"required"`
		Address      string   `json:"address"`
		ServerId     int64    `json:"server_id"`
		InboundAlias string   `json:"inbound_alias"`
		Protocol     string   `json:"protocol,omitempty"`
		Enabled      *bool    `json:"enabled"`
	}
	UpdateNodeRequest {
		Id           int64    `json:"id"`
		Name         string   `json:"name"`
		Tags         []string `json:"tags,omitempty"`
		Port         uint16   `json:"port" validate:"required"`
		Address      string   `json:"address"`
		ServerId     int64    `json:"server_id"`
		InboundAlias string   `json:"inbound_alias"`
		Protocol     string   `json:"protocol,omitempty"`
		Enabled      *bool    `json:"enabled"`
	}
	ToggleNodeStatusRequest {
		Id     int64 `json:"id"`
		Enable *bool `json:"enable"`
	}
	DeleteNodeRequest {
		Id int64 `json:"id"`
	}
	FilterNodeListRequest {
		Page   int    `form:"page"`
		Size   int    `form:"size"`
		Search string `form:"search,omitempty"`
	}
	FilterNodeListResponse {
		Total int64          `json:"total"`
		List  []NodeListItem `json:"list"`
	}
	HasMigrateSeverNodeResponse {
		HasMigrate bool `json:"has_migrate"`
	}
	MigrateServerNodeResponse {
		Succee  uint64 `json:"succee"`
		Fail    uint64 `json:"fail"`
		Message string `json:"message,omitempty"`
	}
	ResetSortRequest {
		Sort []SortItem `json:"sort"`
	}
	QueryNodeTagResponse {
		Tags []string `json:"tags"`
	}
	CreateXrayTemplateRequest {
		Name             string          `json:"name"`
		Type             string          `json:"type"`
		Config           json.RawMessage `json:"config"`
		ConfigTemplate   string          `json:"config_template,omitempty"`
		VariablesSchema  json.RawMessage `json:"variables_schema,omitempty"`
		DefaultVariables json.RawMessage `json:"default_variables,omitempty"`
		SubscriptionMeta json.RawMessage `json:"subscription_meta,omitempty"`
		Description      string          `json:"description,omitempty"`
		Enabled          *bool           `json:"enabled"`
	}
	UpdateXrayTemplateRequest {
		Id               int64           `json:"id"`
		Name             *string         `json:"name,omitempty"`
		Type             *string         `json:"type,omitempty"`
		Config           json.RawMessage `json:"config,omitempty"`
		ConfigTemplate   *string         `json:"config_template,omitempty"`
		VariablesSchema  json.RawMessage `json:"variables_schema,omitempty"`
		DefaultVariables json.RawMessage `json:"default_variables,omitempty"`
		SubscriptionMeta json.RawMessage `json:"subscription_meta,omitempty"`
		Description      *string         `json:"description,omitempty"`
		Enabled          *bool           `json:"enabled"`
	}
	DeleteXrayTemplateRequest {
		Id int64 `json:"id"`
	}
	GetXrayTemplateDetailRequest {
		Id int64 `form:"id"`
	}
	FilterXrayTemplateListRequest {
		Page    int    `form:"page"`
		Size    int    `form:"size"`
		Type    string `form:"type,omitempty"`
		Search  string `form:"search,omitempty"`
		Enabled *bool  `form:"enabled,omitempty"`
	}
	FilterXrayTemplateListResponse {
		Total int64                  `json:"total"`
		List  []XrayTemplateListItem `json:"list"`
	}
	QueryXrayTemplateCatalogRequest {
		Page    int    `form:"page"`
		Size    int    `form:"size"`
		Type    string `form:"type,omitempty"`
		Search  string `form:"search,omitempty"`
		Enabled *bool  `form:"enabled,omitempty"`
	}
	QueryXrayTemplateCatalogResponse {
		Total int64                     `json:"total"`
		List  []XrayTemplateCatalogItem `json:"list"`
	}
	ServerXrayTemplateBinding {
		TemplateId            int64           `json:"template_id"`
		Alias                 string          `json:"alias,omitempty"`
		Variables             json.RawMessage `json:"variables,omitempty"`
		SubscriptionEnabled   *bool           `json:"subscription_enabled,omitempty"`
		SubscriptionName      string          `json:"subscription_name,omitempty"`
		SubscriptionVariables json.RawMessage `json:"subscription_variables,omitempty"`
		Sort                  int             `json:"sort,omitempty"`
		Enabled               *bool           `json:"enabled"`
	}
	BindServerXrayTemplatesRequest {
		ServerId  int64                       `json:"server_id"`
		Bindings []ServerXrayTemplateBinding `json:"bindings"`
	}
	QueryServerXrayTemplateListRequest {
		ServerId              int64 `form:"server_id"`
		IncludeTemplate       *bool `form:"include_template,omitempty"`
		IncludeStatus         *bool `form:"include_status,omitempty"`
		IncludeDesiredConfig  *bool `form:"include_desired_config,omitempty"`
	}
	ServerXrayTemplate {
		Id                    int64           `json:"id"`
		ServerId              int64           `json:"server_id"`
		TemplateId            int64           `json:"template_id"`
		Alias                 string          `json:"alias"`
		Variables             json.RawMessage `json:"variables"`
		SubscriptionEnabled   bool            `json:"subscription_enabled"`
		SubscriptionName      string          `json:"subscription_name"`
		SubscriptionVariables json.RawMessage `json:"subscription_variables"`
		Sort                  int             `json:"sort"`
		Enabled               bool            `json:"enabled"`
		Template              *XrayTemplate   `json:"template,omitempty"`
		CreatedAt             int64           `json:"created_at"`
		UpdatedAt             int64           `json:"updated_at"`
	}
	QueryServerXrayTemplateListResponse {
		List               []ServerXrayTemplate `json:"list"`
		DesiredConfigHash  string               `json:"desired_config_hash,omitempty"`
		DesiredConfigError string               `json:"desired_config_error,omitempty"`
		Status             *ServerStatus        `json:"status,omitempty"`
	}
	PreviewServerXrayConfigRequest {
		ServerId int64                       `json:"server_id"`
		Bindings []ServerXrayTemplateBinding `json:"bindings"`
	}
	XrayTemplateVariablePreview {
		Type                        string          `json:"type"`
		Alias                       string          `json:"alias"`
		TemplateId                  int64           `json:"template_id"`
		TemplateName                string          `json:"template_name"`
		Sort                        int             `json:"sort"`
		ConfigVariables             json.RawMessage `json:"config_variables"`
		DefaultVariables            json.RawMessage `json:"default_variables"`
		BindingVariables            json.RawMessage `json:"binding_variables"`
		MergedVariables             json.RawMessage `json:"merged_variables"`
		SubscriptionVariables       json.RawMessage `json:"subscription_variables"`
		SubscriptionMergedVariables json.RawMessage `json:"subscription_merged_variables"`
		Ref                         json.RawMessage `json:"ref"`
	}
	PreviewServerXrayConfigResponse {
		Inbounds            []json.RawMessage                      `json:"inbounds"`
		Outbounds           []json.RawMessage                      `json:"outbounds"`
		DNS                 json.RawMessage                        `json:"dns,omitempty"`
		Routing             json.RawMessage                        `json:"routing,omitempty"`
		Geodata             json.RawMessage                        `json:"geodata,omitempty"`
		Templates           []XrayTemplate                         `json:"templates"`
		SubscriptionProxies []json.RawMessage                      `json:"subscription_proxies"`
		Variables           map[string]XrayTemplateVariablePreview `json:"variables"`
	}
)

@server (
	prefix:     v1/admin/server
	group:      admin/server
	middleware: AuthMiddleware
)
service alpha {
	@doc "Create Server"
	@handler CreateServer
	post /create (CreateServerRequest)

	@doc "Update Server"
	@handler UpdateServer
	post /update (UpdateServerRequest)

	@doc "Delete Server"
	@handler DeleteServer
	post /delete (DeleteServerRequest)

	@doc "Filter Server List"
	@handler FilterServerList
	get /list (FilterServerListRequest) returns (FilterServerListResponse)

	@doc "Query per-server network rate history"
	@handler QueryServerNetworkRateHistory
	get /network-rate/history (QueryServerNetworkRateHistoryRequest) returns (QueryServerNetworkRateHistoryResponse)

	@doc "Query the authentication token bound to one server"
	@handler QueryServerNodeToken
	get /node-token (QueryServerNodeTokenRequest) returns (QueryServerNodeTokenResponse)

	@doc "Create Node"
	@handler CreateNode
	post /node/create (CreateNodeRequest)

	@doc "Update Node"
	@handler UpdateNode
	post /node/update (UpdateNodeRequest)

	@doc "Delete Node"
	@handler DeleteNode
	post /node/delete (DeleteNodeRequest)

	@doc "Filter Node List"
	@handler FilterNodeList
	get /node/list (FilterNodeListRequest) returns (FilterNodeListResponse)

	@doc "Toggle Node Status"
	@handler ToggleNodeStatus
	post /node/status/toggle (ToggleNodeStatusRequest)

	@doc "Reset server sort"
	@handler ResetSortWithServer
	post /server/sort (ResetSortRequest)

	@doc "Reset node sort"
	@handler ResetSortWithNode
	post /node/sort (ResetSortRequest)

	@doc "Query all node tags"
	@handler QueryNodeTag
	get /node/tags returns (QueryNodeTagResponse)

	@doc "Create xray template"
	@handler CreateXrayTemplate
	post /xray-template/create (CreateXrayTemplateRequest)

	@doc "Update xray template"
	@handler UpdateXrayTemplate
	post /xray-template/update (UpdateXrayTemplateRequest)

	@doc "Delete xray template"
	@handler DeleteXrayTemplate
	post /xray-template/delete (DeleteXrayTemplateRequest)

	@doc "Get xray template detail"
	@handler GetXrayTemplateDetail
	get /xray-template/detail (GetXrayTemplateDetailRequest) returns (XrayTemplate)

	@doc "Filter xray template list"
	@handler FilterXrayTemplateList
	get /xray-template/list (FilterXrayTemplateListRequest) returns (FilterXrayTemplateListResponse)

	@doc "Query xray template catalog"
	@handler QueryXrayTemplateCatalog
	get /xray-template/catalog (QueryXrayTemplateCatalogRequest) returns (QueryXrayTemplateCatalogResponse)

	@doc "Bind xray templates to server"
	@handler BindServerXrayTemplates
	post /xray-template/bind (BindServerXrayTemplatesRequest)

	@doc "Query server xray templates"
	@handler QueryServerXrayTemplateList
	get /xray-template/server (QueryServerXrayTemplateListRequest) returns (QueryServerXrayTemplateListResponse)

	@doc "Preview server xray config"
	@handler PreviewServerXrayConfig
	post /xray-template/preview (PreviewServerXrayConfigRequest) returns (PreviewServerXrayConfigResponse)
}
