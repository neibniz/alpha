syntax = "v1"

info (
	title:   "Document API"
	desc:    "API for alpha"
	author:  "Tension"
	email:   "tension@alpha.com"
	version: "0.0.1"
)

import "../types.api"

@server (
	prefix:     v1/public/document
	group:      public/document
	middleware: AuthMiddleware
)
service alpha {
	@doc "Get document list"
	@handler QueryDocumentList
	get /list (QueryDocumentListRequest) returns (QueryDocumentListResponse)

	@doc "Get document detail"
	@handler QueryDocumentDetail
	get /detail (QueryDocumentDetailRequest) returns (Document)
}
